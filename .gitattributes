# Leading-slash anchors to repo root — prevents matching like-named files in subdirs.
/KNOWLEDGE.md filter=git-crypt diff=git-crypt
/TODOS.md filter=git-crypt diff=git-crypt
/.memory/SESSION-LOG.md filter=git-crypt diff=git-crypt
/.work/FINDINGS.md filter=git-crypt diff=git-crypt
/.work/PROGRESS.md filter=git-crypt diff=git-crypt
/.work/PLAN.md filter=git-crypt diff=git-crypt
# Post-mortems narrate internal architecture + vulnerable code paths on a PUBLIC
# repo — same sensitivity class as the files above. Encrypt the whole dir. To
# publish one deliberately (teaching/portfolio, zero-sensitivity), move it out of
# this dir or add a negating pattern below it.
/docs/post-mortems/** filter=git-crypt diff=git-crypt
